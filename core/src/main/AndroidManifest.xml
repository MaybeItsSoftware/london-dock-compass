<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared here because the data layer needs them and both apps use the data layer. Each app
        still decides how and when to ask; a library manifest only states the requirement.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application>
        <!--
            Receives saved docks and the pinned destination from the other device. Declared once
            here so both the watch and the phone pick it up by manifest merge — there is nothing
            form-factor-specific about accepting a saved dock.

            The pathPrefix filter matters: without it this service is woken for every data item any
            part of the app ever writes.
        -->
        <service
            android:name="uk.co.maybeitssoftware.londondockcompass.data.RiderStateListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/rider-state"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
