ROOT   = File.expand_path("..", __dir__)
APP_ID = "uk.co.maybeitssoftware.londondockcompass"

# One applicationId, two bundles. Play routes by device: the :app bundle requires
# android.hardware.type.watch and lives on the wear:* tracks, the :mobile bundle
# has no such requirement and lives on the plain ones. They must carry different
# versionCodes, and wear must be the higher of the two -- see
# scripts/set-gradle-version.sh for why.
WEAR_AAB   = File.join(ROOT, "app", "build", "outputs", "bundle", "release", "app-release.aab")
MOBILE_AAB = File.join(ROOT, "mobile", "build", "outputs", "bundle", "release", "mobile-release.aab")

# Track ids are neither the names the Console displays nor symmetrical across
# form factors. Both closed-testing tracks read "Closed testing - Alpha" in the
# Console, but the wear one is genuinely "wear:Alpha" and the phone one is the
# stock lowercase "alpha" -- so appending a single target to both prefixes, as
# promote used to, promoted the watch and then died on "Track not found: Alpha".
# Callers name a stage and this map resolves the id.
#
# Verified against `fastlane android list_tracks`, not worked out by trial and
# error. Re-run that lane rather than editing these by hand if Play disagrees.
TRACKS = {
  "wear" => {
    "internal"   => "wear:internal",
    "closed"     => "wear:Alpha",
    "open"       => "wear:beta",
    "production" => "wear:production",
  },
  "mobile" => {
    "internal"   => "internal",
    "closed"     => "alpha",
    "open"       => "beta",
    "production" => "production",
  },
}.freeze

platform :android do
  desc "Build both signed release AABs and upload them to their internal testing tracks"
  lane :beta do
    sh("cd #{ROOT} && ./gradlew :app:bundleRelease :mobile:bundleRelease")
    upload_wear(track: TRACKS["wear"]["internal"], with_listing: true)
    upload_mobile(track: TRACKS["mobile"]["internal"])
  end

  desc "Build and upload only the Wear bundle"
  lane :beta_wear do
    sh("cd #{ROOT} && ./gradlew :app:bundleRelease")
    upload_wear(track: TRACKS["wear"]["internal"], with_listing: true)
  end

  desc "Build and upload only the phone bundle"
  lane :beta_mobile do
    sh("cd #{ROOT} && ./gradlew :mobile:bundleRelease")
    upload_mobile(track: TRACKS["mobile"]["internal"])
  end

  desc "Promote the current internal-track builds to another stage"
  desc "  fastlane android promote                        # both -> production"
  desc "  fastlane android promote track:closed           # both -> closed testing"
  desc "  fastlane android promote track:closed form:wear # watch only"
  lane :promote do |options|
    target = options[:track] || "production"
    # "completed" is what supply defaults to. A track that has never had a live
    # rollout only accepts "draft" -- the API rejects completed there with
    # "Only releases with status draft may be created on draft app". Pass
    # status:draft for a first-ever release on a track, then finish the rollout
    # once by hand in Play Console (countries, policies, "Start rollout").
    #
    # If testers report "your device isn't compatible", check here first: a
    # release left sitting in Draft is invisible to them however healthy the
    # bundle is.
    status = options[:status] || "completed"
    form   = options[:form] || "both"

    stages = TRACKS["mobile"].keys
    unless stages.include?(target)
      UI.user_error!("unknown stage #{target.inspect} -- expected one of #{stages.join(", ")}")
    end

    forms = form == "both" ? %w[wear mobile] : [form]
    unless forms.all? { |f| TRACKS.key?(f) }
      UI.user_error!("unknown form #{form.inspect} -- expected wear, mobile or both")
    end

    forms.each do |f|
      promote_track(from: TRACKS[f]["internal"], to: TRACKS[f][target], status: status)
    end
  end

  # Refresh the storefront on its own. The listing is global and not tied to a
  # release, so this needs no build and no track -- useful after regenerating
  # branding/ when the current version code is already live and a fresh upload
  # would be rejected as a duplicate.
  desc "Push store listing images/screenshots to Play without shipping a build"
  lane :upload_assets do |options|
    # supply anchors a listing edit to a release even when changelogs are
    # skipped -- without a version code it dies with "Could not find release
    # for version code '' to update changelog". Read the current one straight
    # out of the gradle file so this can't drift.
    version_code = options[:version_code] ||
                   File.read(File.join(ROOT, "app", "build.gradle.kts"))[/versionCode\s*=\s*(\d+)/, 1]
    UI.user_error!("could not read versionCode from app/build.gradle.kts") unless version_code

    upload_to_play_store(
      package_name:            APP_ID,
      json_key_data:           ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      validate_only:           options[:validate_only] || false,
      track:                   options[:track] || TRACKS["wear"]["internal"],
      version_code:            version_code,
      skip_upload_apk:         true,
      skip_upload_aab:         true,
      skip_upload_changelogs:  true,
      skip_upload_metadata:    true,
      skip_upload_images:      false,
      skip_upload_screenshots: false,
    )
  end

  # Play's track ids are not the names the Console shows you, and they are not
  # symmetrical across form factors: "Closed testing - Alpha" is wear:Alpha on the
  # watch side and something else on the phone side, which is how `promote
  # track:Alpha` came to half-succeed -- wear promoted, phone died on "Track not
  # found: Alpha". Guessing costs a failed run each time, so ask Play instead.
  desc "Print every track id Play knows about, with the releases sitting on it"
  lane :list_tracks do
    require "supply"

    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      {
        package_name:  APP_ID,
        json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
        track:         "internal",
      },
    )

    client = Supply::Client.make_from_config
    client.begin_edit(package_name: APP_ID)
    begin
      tracks = client.tracks
      UI.user_error!("Play returned no tracks at all for #{APP_ID}") if tracks.empty?
      tracks.each do |track|
        releases = Array(track.releases).map do |release|
          "#{release.status} #{release.name.inspect} codes=#{Array(release.version_codes).join(",")}"
        end
        UI.important("#{track.track.inspect} -> #{releases.empty? ? "(no releases)" : releases.join(" | ")}")
      end
    ensure
      client.abort_current_edit
    end
  end

  desc "Download metadata and screenshots from Google Play Store"
  lane :download_metadata do
    sh("bundle exec fastlane supply init --json_key_data '#{ENV["PLAY_SERVICE_ACCOUNT_JSON"]}' --metadata_path '#{File.join(__dir__, "metadata", "android")}'")
  end

  # --- helpers -------------------------------------------------------------

  # The store listing is global, not per-track: images go live as soon as the
  # edit commits, whatever track the bundle lands on. Uploading them from one
  # lane only is what stops the two form factors racing to write the same
  # listing in separate edits.
  #
  # metadata (title/descriptions) stays skipped because there are no .txt files
  # under fastlane/metadata/android/en-GB -- supply would have nothing to send.
  # Run `fastlane android download_metadata` to seed them from the live listing
  # first, then flip this to false.
  private_lane :upload_wear do |options|
    UI.user_error!("missing #{WEAR_AAB} -- run ./gradlew :app:bundleRelease") unless File.exist?(WEAR_AAB)
    upload_to_play_store(
      package_name:            APP_ID,
      track:                   options[:track],
      aab:                     WEAR_AAB,
      json_key_data:           ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_images:      !options[:with_listing],
      skip_upload_screenshots: !options[:with_listing],
    )
  end

  private_lane :upload_mobile do |options|
    UI.user_error!("missing #{MOBILE_AAB} -- run ./gradlew :mobile:bundleRelease") unless File.exist?(MOBILE_AAB)
    upload_to_play_store(
      package_name:            APP_ID,
      track:                   options[:track],
      aab:                     MOBILE_AAB,
      json_key_data:           ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
    )
  end

  # skip_upload_changelogs matters here in a way it does not in the upload lanes.
  # supply anchors a changelog edit to a specific version code, and it takes that
  # code from the binary it just pushed -- but a promotion pushes no binary, so
  # there is nothing to read it from and it dies with "Cannot find changelog
  # because no version code given". Skipping metadata and images is not enough;
  # changelogs are a third thing. Same root cause as the note in upload_assets.
  private_lane :promote_track do |options|
    upload_to_play_store(
      package_name:                 APP_ID,
      track:                        options[:from],
      track_promote_to:             options[:to],
      track_promote_release_status: options[:status],
      json_key_data:                ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_apk:              true,
      skip_upload_aab:              true,
      skip_upload_metadata:         true,
      skip_upload_changelogs:       true,
      skip_upload_images:           true,
      skip_upload_screenshots:      true,
    )
  end
end
